{
  "name": "accesspath-sd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:ui": "node --import tsx --test tests/ui/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/ingest/run-all.ts",
    "ingest:safe": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/ingest/branch-ingest.ts",
    "coverage": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/ingest/check-coverage.ts",
    "ai:notice": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/ai/notice-pipeline.ts",
    "ai:image": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/ai/analyze-sample.ts",
    "ai:investigate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/ai/investigate-sample.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.83.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neondatabase/serverless": "^0.10.4",
    "csv-parse": "^5.6.0",
    "leaflet": "^1.9.4",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
